{
  "name": "zypin",
  "version": "1.0.0",
  "description": "A simplified, all-in-one testing framework.",
  "main": "cli/index.js",
  "type": "module",
  "bin": {
    "zypin": "cli/index.js",
    "cucumber-js": "./node_modules/@cucumber/cucumber/bin/cucumber.js"
  },
  "exports": {
    ".": "./cli/index.js",
    "./selenium": "./lib/selenium.js",
    "./playwright": "./lib/playwright.js",
    "./cucumber": "./lib/cucumber/index.js",
    "./regression": "./lib/regression/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "testing",
    "automation",
    "mcp",
    "playwright",
    "selenium"
  ],
  "author": "Zypin Testing",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zypin-testing/zypin.git"
  },
  "homepage": "https://github.com/zypin-testing/zypin#readme",
  "bugs": {
    "url": "https://github.com/zypin-testing/zypin/issues"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@playwright/test": "1.56.0-alpha-2025-10-01",
    "chai": "^5.1.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "junit-report-builder": "^5.1.1",
    "playwright-core": "1.56.0-alpha-2025-10-01",
    "selenium-webdriver": "^4.35.0",
    "zod": "^3.25.76"
  }
}
