[
  {
    "name": "Button Click Counter",
    "description": "Test button click interaction with counter",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#clickButton"
      },
      {
        "type": "click",
        "selector": "#clickButton",
        "description": "Click the button 3 times"
      },
      {
        "type": "click",
        "selector": "#clickButton"
      },
      {
        "type": "click",
        "selector": "#clickButton"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout"
      }
    ]
  },
  {
    "name": "Form Fill Complete Flow",
    "description": "Complete form interaction with all input types",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#demoForm"
      },
      {
        "type": "type",
        "selector": "#nameInput",
        "text": "Test User"
      },
      {
        "type": "type",
        "selector": "#emailInput",
        "text": "user@example.com"
      },
      {
        "type": "check",
        "selector": "[data-testid='checkbox-playwright']"
      },
      {
        "type": "check",
        "selector": "[data-testid='checkbox-selenium']"
      },
      {
        "type": "click",
        "selector": "[data-testid='radio-intermediate']"
      },
      {
        "type": "select",
        "selector": "#countrySelect",
        "value": "vn"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout"
      }
    ]
  },
