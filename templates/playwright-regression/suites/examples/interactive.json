[
  {
    "name": "Click and Wait Example",
    "description": "Demonstrate click and sleep actions",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "click",
        "selector": ".get-started-link",
        "options": {"timeout": 5000}
      },
      {
        "type": "sleep",
        "duration": 2000
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {"fullPage": true}
      }
    ]
  }
]

