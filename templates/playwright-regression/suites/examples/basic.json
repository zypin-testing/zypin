[
  {
    "name": "Basic Visual Test",
    "description": "Simplest possible visual regression test - no actions, just screenshot",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime",
        "description": "Hide dynamic timestamp to make test stable"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true,
          "maxDiffPixelRatio": 0.01
        }
      }
    ]
  }
]

