[
  {
    "name": "Screen Collector Demo",
    "description": "Visual screenshot comparison with layout comparator",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true,
          "maxDiffPixelRatio": 0.01
        }
      }
    ]
  },
  {
    "name": "Source Collector Demo",
    "description": "HTML source code comparison",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "options": {
          "baselineDir": "baselines/source"
        }
      }
    ]
  },
  {
    "name": "JS Errors Collector Demo",
    "description": "Monitor and validate JavaScript console errors",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      }
    ],
    "collect": [
      {
        "type": "jsErrors",
        "comparator": "jsErrors",
        "options": {
          "maxErrors": 0,
          "allowedPatterns": [
            "analytics.*",
            "tracking.*"
          ],
          "includeErrors": true
        }
      }
    ]
  },
  {
    "name": "Status Codes Collector Demo",
    "description": "Validate HTTP response status codes for all resources",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      }
    ],
    "collect": [
      {
        "type": "statusCodes",
        "comparator": "statusCodes",
        "options": {
          "allowedCodes": [200, 201, 204, 301, 302, 304],
          "ignorePatterns": [
            "analytics\\.google\\.com",
            "doubleclick\\.net",
            "googletagmanager\\.com"
          ],
          "includeFailures": true
        }
      }
    ]
  },
  {
    "name": "Cookies Collector Demo",
    "description": "Capture and compare browser cookies",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "loadCookies",
        "cookies": [
          {
            "name": "test_cookie",
            "value": "demo_value",
            "domain": ".github.io",
            "path": "/",
            "secure": true
          }
        ]
      }
    ],
    "collect": [
      {
        "type": "cookies",
        "comparator": "cookies",
        "options": {
          "baselineDir": "baselines/cookies"
        }
      }
    ]
  },
  {
    "name": "Performance Collector Demo",
    "description": "Collect Core Web Vitals and performance metrics (no comparator)",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      },
      {
        "type": "waitForImages",
        "timeout": 10000
      }
    ],
    "collect": [
      {
        "type": "performance"
      }
    ]
  },
  {
    "name": "Multi-Collector: Visual + Source",
    "description": "Combine screenshot and HTML source comparison",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true,
          "maxDiffPixelRatio": 0.01
        }
      },
      {
        "type": "source",
        "comparator": "source"
      }
    ]
  },
  {
    "name": "Multi-Collector: Visual + JS Errors + Status Codes",
    "description": "Comprehensive test with visual, error, and HTTP validation",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime"
      },
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true
        }
      },
      {
        "type": "jsErrors",
        "comparator": "jsErrors",
        "options": {
          "maxErrors": 0
        }
      },
      {
        "type": "statusCodes",
        "comparator": "statusCodes",
        "options": {
          "allowedCodes": [200, 304]
        }
      }
    ]
  },
  {
    "name": "Complete Multi-Collector Suite",
    "description": "Use all collectors together for comprehensive validation",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      },
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      },
      {
        "type": "waitForImages",
        "timeout": 10000
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true,
          "maxDiffPixelRatio": 0.01
        }
      },
      {
        "type": "source",
        "comparator": "source"
      },
      {
        "type": "jsErrors",
        "comparator": "jsErrors",
        "options": {
          "maxErrors": 0
        }
      },
      {
        "type": "statusCodes",
        "comparator": "statusCodes",
        "options": {
          "allowedCodes": [200, 304]
        }
      },
      {
        "type": "cookies",
        "comparator": "cookies"
      },
      {
        "type": "performance"
      }
    ]
  }
]
