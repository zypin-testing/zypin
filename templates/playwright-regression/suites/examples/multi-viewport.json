[
  {
    "name": "Responsive Homepage Test",
    "description": "Test homepage across multiple viewport sizes to ensure responsive design",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop-1920", "width": 1920, "height": 1080},
      {"name": "Desktop-1366", "width": 1366, "height": 768},
      {"name": "Tablet-Portrait", "width": 768, "height": 1024},
      {"name": "Tablet-Landscape", "width": 1024, "height": 768},
      {"name": "Mobile-Large", "width": 414, "height": 896},
      {"name": "Mobile-Small", "width": 375, "height": 667}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime",
        "description": "Hide timestamp for stable test"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      },
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true,
          "maxDiffPixelRatio": 0.02
        }
      }
    ]
  },
  {
    "name": "Responsive Navigation Test",
    "description": "Test navigation menu behavior across different viewports",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080},
      {"name": "Tablet", "width": 768, "height": 1024},
      {"name": "Mobile", "width": 414, "height": 896}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime"
      },
      {
        "type": "scroll",
        "x": 0,
        "y": 0,
        "description": "Ensure at top of page"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout"
      }
    ]
  },
  {
    "name": "Responsive Form Layout",
    "description": "Verify form layout adapts correctly to different screen sizes",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080},
      {"name": "Tablet", "width": 768, "height": 1024},
      {"name": "Mobile", "width": 414, "height": 896}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#demoForm"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout"
      }
    ]
  }
]

