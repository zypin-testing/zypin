[
  {
    "name": "Regex Filter - Replace Dates",
    "description": "Use regex to replace date patterns with placeholders",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "regex",
            "pattern": "\\d{4}-\\d{2}-\\d{2}",
            "replacement": "{{DATE}}",
            "flags": "g",
            "description": "Replace ISO date format (YYYY-MM-DD)"
          },
          {
            "type": "regex",
            "pattern": "\\d{1,2}:\\d{2}:\\d{2}",
            "replacement": "{{TIME}}",
            "flags": "g",
            "description": "Replace time format (HH:MM:SS)"
          }
        ]
      }
    ]
  },
  {
    "name": "Regex Filter - Replace Version Numbers",
    "description": "Normalize version numbers in HTML source",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "regex",
            "pattern": "v\\d+\\.\\d+\\.\\d+",
            "replacement": "v{{VERSION}}",
            "flags": "gi",
            "description": "Replace semantic version numbers"
          }
        ]
      }
    ]
  },
  {
    "name": "Remove Filter - Strip Comments and IDs",
    "description": "Remove HTML comments and data-testid attributes",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "remove",
            "patterns": [
              "<!--.*?-->",
              "data-testid=\"[^\"]*\"",
              "timestamp"
            ],
            "description": "Remove comments, test IDs, and timestamp references"
          }
        ]
      }
    ]
  },
  {
    "name": "RemoveNodes Filter - Strip Scripts and Styles",
    "description": "Remove entire DOM nodes before comparison",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "removeNodes",
            "selectors": [
              "script",
              "style",
              "noscript"
            ],
            "description": "Remove script and style tags from HTML"
          }
        ]
      }
    ]
  },
  {
    "name": "RemoveNodes Filter - Remove Dynamic Elements",
    "description": "Remove dynamic content sections before comparison",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "removeNodes",
            "selectors": [
              "#currentTime",
              ".timestamp",
              ".live-data",
              "[data-dynamic]"
            ],
            "description": "Remove all dynamic content elements"
          }
        ]
      }
    ]
  },
  {
    "name": "Extract Filter - Extract Headings Only",
    "description": "Extract only specific content patterns (headings)",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "extract",
            "selector": "<h[1-6][^>]*>.*?</h[1-6]>",
            "description": "Extract all heading tags (h1-h6)"
          }
        ]
      }
    ]
  },
  {
    "name": "Chained Filters - Multiple Steps",
    "description": "Apply multiple filters in sequence for comprehensive cleaning",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "removeNodes",
            "selectors": ["script", "style"],
            "description": "Step 1: Remove scripts and styles"
          },
          {
            "type": "regex",
            "pattern": "\\s+",
            "replacement": " ",
            "flags": "g",
            "description": "Step 2: Normalize all whitespace"
          },
          {
            "type": "remove",
            "patterns": ["<!--.*?-->"],
            "description": "Step 3: Remove HTML comments"
          },
          {
            "type": "regex",
            "pattern": "\\d{4}-\\d{2}-\\d{2}",
            "replacement": "{{DATE}}",
            "flags": "g",
            "description": "Step 4: Replace dates"
          }
        ]
      }
    ]
  },
  {
    "name": "Chained Filters - Advanced Cleaning",
    "description": "Advanced filter chain for stable HTML comparison",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [],
    "collect": [
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "removeNodes",
            "selectors": [
              "#currentTime",
              ".timestamp",
              ".live-data"
            ],
            "description": "Remove dynamic elements"
          },
          {
            "type": "remove",
            "patterns": [
              "data-testid=\"[^\"]*\"",
              "data-reactroot=\"[^\"]*\"",
              "nonce=\"[^\"]*\""
            ],
            "description": "Remove test and framework attributes"
          },
          {
            "type": "regex",
            "pattern": "id=\"[a-z0-9-]+\"",
            "replacement": "id=\"{{ID}}\"",
            "flags": "g",
            "description": "Normalize dynamic IDs"
          }
        ]
      }
    ]
  },
  {
    "name": "Visual Test with Hidden Elements (Hide Action)",
    "description": "Combine hide actions with visual comparison (alternative to filters)",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime",
        "description": "Hide timestamp in hero section"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      },
      {
        "type": "hide",
        "selector": ".live-data"
      },
      {
        "type": "hide",
        "selector": ".version-badge"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true,
          "maxDiffPixelRatio": 0.01
        }
      }
    ]
  },
  {
    "name": "Combined: Visual + Filtered Source",
    "description": "Use both visual testing with hidden elements and filtered source comparison",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true
        }
      },
      {
        "type": "source",
        "comparator": "source",
        "filters": [
          {
            "type": "removeNodes",
            "selectors": ["script", "style"]
          },
          {
            "type": "regex",
            "pattern": "\\d{4}-\\d{2}-\\d{2}",
            "replacement": "{{DATE}}",
            "flags": "g"
          },
          {
            "type": "remove",
            "patterns": ["data-testid="]
          }
        ]
      }
    ]
  }
]
