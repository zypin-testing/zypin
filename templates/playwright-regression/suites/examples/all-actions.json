[
  {
    "name": "Click Action Demo",
    "description": "Demonstrate click action on buttons and links",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#clickButton"
      },
      {
        "type": "click",
        "selector": "#clickButton",
        "description": "Click button to increment counter"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "Type Action Demo",
    "description": "Demonstrate typing text into input fields",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#nameInput"
      },
      {
        "type": "type",
        "selector": "#nameInput",
        "text": "John Doe",
        "description": "Type into name field"
      },
      {
        "type": "type",
        "selector": "#emailInput",
        "text": "john@example.com"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "Check/Uncheck Action Demo",
    "description": "Demonstrate checkbox checking and unchecking",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#demoForm"
      },
      {
        "type": "check",
        "selector": "[data-testid='checkbox-playwright']",
        "description": "Check Playwright checkbox"
      },
      {
        "type": "check",
        "selector": "[data-testid='checkbox-selenium']"
      },
      {
        "type": "uncheck",
        "selector": "[data-testid='checkbox-playwright']",
        "description": "Uncheck Playwright checkbox"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "Select Action Demo",
    "description": "Demonstrate dropdown selection",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#countrySelect"
      },
      {
        "type": "select",
