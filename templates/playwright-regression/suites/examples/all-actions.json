        "value": "vn",
        "description": "Select Vietnam from dropdown"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "Hover Action Demo",
