  {
    "name": "ReplaceText Action Demo",
    "description": "Demonstrate replacing text in elements",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "replaceText",
        "selector": ".logo",
        "text": "Modified Title",
        "description": "Replace logo text"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "WaitForElement Action Demo",
    "description": "Demonstrate waiting for element to be visible",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "waitForElement",
        "selector": "nav",
        "state": "visible",
        "timeout": 5000,
        "description": "Wait for navigation to be visible"
      },
      {
        "type": "waitForElement",
        "selector": "#demoForm",
        "state": "visible"
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "WaitForPageLoaded Action Demo",
    "description": "Demonstrate waiting for page load states",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "waitForPageLoaded",
        "state": "networkidle",
        "timeout": 30000,
        "description": "Wait for network to be idle"
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
