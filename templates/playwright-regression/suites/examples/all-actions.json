  {
    "name": "Sleep Action Demo",
    "description": "Demonstrate pausing execution with sleep",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "sleep",
        "duration": 1000,
        "description": "Wait 1 second before taking screenshot"
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "SetViewport Action Demo",
    "description": "Demonstrate changing viewport during test execution",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Initial", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "sleep",
        "duration": 500
      },
      {
        "type": "setViewport",
        "width": 768,
        "height": 1024,
        "description": "Change to tablet viewport"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "ExecuteScript Action Demo",
    "description": "Demonstrate executing custom JavaScript",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "executeScript",
        "script": "() => { document.body.style.backgroundColor = '#e3f2fd'; }",
        "description": "Change background color via script"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "LoadCookies Action Demo",
    "description": "Demonstrate loading cookies before page navigation",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "loadCookies",
        "cookies": [
          {
            "name": "demo_cookie",
            "value": "test_value_123",
            "domain": ".github.io",
            "path": "/",
            "secure": true,
            "httpOnly": false,
            "sameSite": "Lax"
          }
        ],
        "description": "Load cookies for authentication/session"
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"},
      {"type": "cookies", "comparator": "cookies"}
    ]
  },
  {
    "name": "Complex Multi-Action Workflow",
    "description": "Combine multiple actions in a realistic test scenario",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime"
      },
      {
        "type": "hide",
        "selector": ".timestamp"
      },
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      },
      {
        "type": "scroll",
        "selector": "#demoForm"
      },
      {
        "type": "type",
        "selector": "#nameInput",
        "text": "Test User"
      },
      {
        "type": "check",
        "selector": "[data-testid='checkbox-playwright']"
      },
      {
        "type": "select",
        "selector": "#countrySelect",
        "value": "vn"
      },
      {
        "type": "scroll",
        "selector": "#dropdownButton"
      },
      {
        "type": "click",
        "selector": "#dropdownButton"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  }
]
