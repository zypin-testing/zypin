  {
    "name": "Scroll Action Demo",
    "description": "Demonstrate scrolling to elements and coordinates",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#footer",
        "description": "Scroll to footer"
      },
      {
        "type": "sleep",
        "duration": 500
      },
      {
        "type": "scroll",
        "x": 0,
        "y": 500,
        "description": "Scroll to specific coordinates"
      },
      {
        "type": "sleep",
        "duration": 500
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout"}
    ]
  },
  {
    "name": "Hide Action Demo",
    "description": "Demonstrate hiding dynamic elements",
    "urls": ["https://zypin-testing.github.io/zypin-demo-website/"],
    "viewports": [
      {"name": "Desktop", "width": 1920, "height": 1080}
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime",
        "description": "Hide timestamp element"
      },
      {
        "type": "hide",
        "selector": ".version-badge",
        "description": "Hide version badge"
      }
    ],
    "collect": [
      {"type": "screen", "comparator": "layout", "options": {"fullPage": true}}
