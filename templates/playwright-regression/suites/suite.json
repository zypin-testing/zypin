[
  {
    "name": "Homepage Visual Regression",
    "description": "Full page visual test with dynamic content hidden",
    "urls": [
      "https://zypin-testing.github.io/zypin-demo-website/"
    ],
    "viewports": [
      {
        "name": "Desktop",
        "width": 1920,
        "height": 1080
      },
      {
        "name": "Tablet",
        "width": 768,
        "height": 1024
      },
      {
        "name": "Mobile",
        "width": 414,
        "height": 896
      }
    ],
    "actions": [
      {
        "type": "hide",
        "selector": "#currentTime",
        "description": "Hide dynamic timestamp in hero section"
      },
      {
        "type": "hide",
        "selector": ".live-data",
        "description": "Hide live counter"
      },
      {
        "type": "hide",
        "selector": "#currentTime",
        "description": "Hide all timestamps"
      },
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout",
        "options": {
          "fullPage": true,
          "maxDiffPixelRatio": 0.01
        }
      },
      {
        "type": "jsErrors",
        "comparator": "jsErrors",
        "options": {
          "maxErrors": 0
        }
      }
    ]
  },
  {
    "name": "Form Interaction Flow",
    "description": "Test form filling and validation",
    "urls": [
      "https://zypin-testing.github.io/zypin-demo-website/"
    ],
    "viewports": [
      {
        "name": "Desktop",
        "width": 1920,
        "height": 1080
      }
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "#demoForm",
        "description": "Scroll to form section"
      },
      {
        "type": "sleep",
        "duration": 500
      },
      {
        "type": "type",
        "selector": "#nameInput",
        "text": "Zypin Tester",
        "description": "Fill in name field"
      },
      {
        "type": "type",
        "selector": "#emailInput",
        "text": "test@zypin.dev"
      },
      {
        "type": "check",
        "selector": "[data-testid='checkbox-playwright']"
      },
      {
        "type": "select",
        "selector": "#countrySelect",
        "value": "vn"
      },
      {
        "type": "sleep",
        "duration": 300
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout"
      }
    ]
  },
  {
    "name": "Interactive Elements Test",
    "description": "Test hover, click, and dropdown interactions",
    "urls": [
      "https://zypin-testing.github.io/zypin-demo-website/"
    ],
    "viewports": [
      {
        "name": "Desktop",
        "width": 1920,
        "height": 1080
      }
    ],
    "actions": [
      {
        "type": "scroll",
        "selector": "[data-testid='dropdown-menu']"
      },
      {
        "type": "click",
        "selector": "#dropdownButton",
        "description": "Open dropdown menu"
      },
      {
        "type": "sleep",
        "duration": 500
      },
      {
        "type": "hover",
        "selector": "[data-testid='hover-card']",
        "description": "Trigger hover effect"
      },
      {
        "type": "sleep",
        "duration": 300
      }
    ],
    "collect": [
      {
        "type": "screen",
        "comparator": "layout"
      }
    ]
  },
  {
    "name": "HTTP Status & Performance Check",
    "description": "Validate all resources load correctly with performance metrics",
    "urls": [
      "https://zypin-testing.github.io/zypin-demo-website/"
    ],
    "viewports": [
      {
        "name": "Desktop",
        "width": 1920,
        "height": 1080
      }
    ],
    "actions": [
      {
        "type": "waitForPageLoaded",
        "state": "networkidle"
      }
    ],
    "collect": [
      {
        "type": "statusCodes",
        "comparator": "statusCodes",
        "options": {
          "allowedCodes": [200, 304],
          "includeFailures": true
        }
      },
      {
        "type": "performance"
      }
    ]
  }
]

